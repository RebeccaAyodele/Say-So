# SaySo Environment Variables Configuration

# Server Environment
NODE_ENV=development
PORT=3000
SERVER_URL=http://localhost:3000

# Supabase Auth
# Required for token validation on backend and client authentication in extension
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# MongoDB Atlas
# Persistent store for user profiles, contact profiles, preferences, candidates, and learning events
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sayso?retryWrites=true&w=majority
MONGODB_DB_NAME=sayso

# OpenRouter (Gemma Open-Weight Inference)
OPENROUTER_API_KEY=your-openrouter-api-key
GEMMA_MODEL_ID=google/gemma-2-9b-it
# Fallback or alternative: google/gemma-2-27b-it

# Sentry Agent Tracing & Monitoring (Optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# CORS & Extension Client
# Chrome extension origin format: chrome-extension://<EXTENSION_ID>
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
