{
  "name": "say-so-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "SaySo: AI-powered Personal Reply Assistant for WhatsApp Web",
  "scripts": {
    "build": "pnpm --filter @sayso/shared build && pnpm --recursive --filter !@sayso/shared build",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "pnpm --recursive lint",
    "dev:server": "pnpm --filter @sayso/server dev",
    "dev:extension": "pnpm --filter @sayso/extension dev"
  },
  "keywords": [
    "ai",
    "gemma",
    "chrome-extension",
    "whatsapp-web",
    "mongodb-atlas",
    "hacktoberfest"
  ],
  "author": "SaySo Contributors",
  "license": "Apache-2.0",
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
